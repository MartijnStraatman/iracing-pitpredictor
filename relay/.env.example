# copy to .env and change both values
INGEST_TOKEN=change-me-long-random-string
VIEW_TOKEN=team-viewer-key

# set DEMO=1 to run a self-generating sample race (no iRacing client needed)
DEMO=

# uid/gid the relay writes ./data/events.jsonl as -- must own that directory.
# `id -u` / `id -g` on the host; leave unset if the deploy user is 1000:1000.
PUID=
PGID=
